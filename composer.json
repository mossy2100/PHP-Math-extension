{
    "name": "oceanmoon/math-ext",
    "description": "A native PHP extension providing the same Complex, Rational, Vector and Matrix classes from oceanmoon/math, plus operators.",
    "type": "php-ext",
    "license": "MIT",
    "keywords": [
        "php",
        "extension",
        "math",
        "complex",
        "rational",
        "fraction",
        "arithmetic",
        "vector",
        "matrix",
        "trigonometry",
        "operator-overloading"
    ],
    "authors": [
        {
            "name": "Shaun Moss",
            "email": "mossy2100@gmail.com"
        }
    ],
    "homepage": "https://github.com/mossy2100/PHP-Math-extension",
    "support": {
        "issues": "https://github.com/mossy2100/PHP-Math-extension/issues",
        "source": "https://github.com/mossy2100/PHP-Math-extension"
    },
    "require": {
        "php": ">=8.4 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "oceanmoon/coding-standard": "^2.2",
        "oceanmoon/core": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "OceanMoon\\Math\\PHPStan\\": "phpstan/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "php-ext": {
        "extension-name": "oceanmoon_math",
        "support-zts": true,
        "support-nts": true,
        "priority": 80,
        "configure-options": []
    },
    "scripts": {
        "fix": "vendor/bin/phpcbf -vp",
        "check": "vendor/bin/phpcs -s",
        "analyze": "scripts/analyze",
        "test": "scripts/test-phpunit",
        "build": "scripts/build",
        "enable": "scripts/enable",
        "disable": "scripts/disable",
        "quality": [
            "@fix",
            "@check",
            "@analyze",
            "@test"
        ]
    }
}
