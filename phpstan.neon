parameters:
    level: 9
    phpVersion: 80400
    paths:
        - tests/phpunit
    scanFiles:
        - mossy2100_math.stub.php
        - phpstan/constants.php
    bootstrapFiles:
        - tests/bootstrap.php

services:
    -
        class: Mossy2100\Math\PHPStan\ComplexBinaryOperatorExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\ComplexUnaryOperatorExtension
        tags:
            - phpstan.broker.unaryOperatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\ComplexComparisonOperatorExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\RationalBinaryOperatorExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\RationalUnaryOperatorExtension
        tags:
            - phpstan.broker.unaryOperatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\RationalComparisonOperatorExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\VectorBinaryOperatorExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\VectorUnaryOperatorExtension
        tags:
            - phpstan.broker.unaryOperatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\MatrixBinaryOperatorExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: Mossy2100\Math\PHPStan\MatrixUnaryOperatorExtension
        tags:
            - phpstan.broker.unaryOperatorTypeSpecifyingExtension
